${1:recyclerView}.setLayoutManager(new androidx.recyclerview.widget.LinearLayoutManager(${2:context}));
$1.setAdapter(${3:adapter});
endsnippet

snippet fragmentReplace "Replace Fragment and add to back stack"
getParentFragmentManager().beginTransaction()
		.replace(R.id.${1:container}, new ${2:TargetFragment}())
		.addToBackStack(null)
		.commit();
endsnippet

snippet workOnce "Enqueue an AndroidX one-time worker"
androidx.work.OneTimeWorkRequest ${1:request} =
		new androidx.work.OneTimeWorkRequest.Builder(${2:MyWorker}.class).build();
androidx.work.WorkManager.getInstance(${3:context}).enqueue($1);
endsnippet

snippet notificationCompat "Build a compatible notification (AndroidX)"
android.app.Notification ${1:notification} = new androidx.core.app.NotificationCompat.Builder(${2:context}, "${3:channel_id}")
		.setSmallIcon(R.drawable.${4:ic_notification})
		.setContentTitle(${5:title})
		.setContentText(${6:message})
		.build();
endsnippet

snippet contextColor "Read color resource with ContextCompat"
int ${1:color} = androidx.core.content.ContextCompat.getColor(${2:context}, R.color.${3:color_name});
endsnippet

snippet viewBindingInflate "Inflate ViewBinding in Activity"
${1:ActivityMainBinding} ${2:binding} = $1.inflate(getLayoutInflater());
setContentView($2.getRoot());
endsnippet
