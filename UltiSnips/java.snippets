
snippet jtoString "toString method"
@Override
public String toString() {
	return "`!p snip.rv = snip.basename`{" +
			"${1:field}='" + $1 + '\'' +
			'}';
}
endsnippet
snippet jconst "Java static final field"
${1:public} static final ${2:int} ${3:key} = ${4:0};
endsnippet

snippet jtryResource "Try-with-resources and IOException handling"
try (${1:java.io.InputStream} ${2:input} = ${3:openStream()}) {
	${4:// Use resource}
} catch (java.io.IOException ${5:error}) {
	${6:// Handle I/O error}
}
endsnippet

snippet jrequireNonNull "Validate a required argument"
java.util.Objects.requireNonNull(${1:value}, "${2:value}");
endsnippet

snippet jparseInt "Parse an integer with error handling"
try {
	int ${1:value} = Integer.parseInt(${2:text});
	${3:// Use value}
} catch (NumberFormatException ${4:error}) {
	${5:// Handle invalid input}
}
endsnippet

snippet jforeachMap "Iterate over map entries"
for (java.util.Map.Entry<${1:String}, ${2:String}> ${3:entry} : ${4:map}.entrySet()) {
	${5:// Use entry.getKey() and entry.getValue()}
}
endsnippet

snippet streamFilter "Stream filter and collect to list"
${1:items}.stream()
		.filter(item -> ${2:item != null})
		.collect(java.util.stream.Collectors.toList())
endsnippet

snippet streamMap "Stream map and collect to list"
${1:items}.stream()
		.map(item -> ${2:item.toString()})
		.collect(java.util.stream.Collectors.toList())
endsnippet

snippet streamDistinct "Stream distinct values"
${1:items}.stream().distinct().collect(java.util.stream.Collectors.toList())
endsnippet

snippet streamGroupBy "Stream groupingBy collector"
${1:items}.stream().collect(java.util.stream.Collectors.groupingBy(item -> ${2:item.getCategory()}))
endsnippet

snippet streamFirst "Find first matching stream element"
${1:items}.stream().filter(item -> ${2:item != null}).findFirst().orElse(null)
endsnippet

snippet streamCount "Count matching stream elements"
${1:items}.stream().filter(item -> ${2:item != null}).count()
endsnippet

snippet streamAnyMatch "Check whether any stream element matches"
${1:items}.stream().anyMatch(item -> ${2:item != null})
endsnippet

snippet streamForEach "Process each stream element"
${1:items}.stream().forEach(item -> {
	${2:// Process item}
});
endsnippet
